# Server Settings
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Stockfish Configuration
# Windows: C:/path/to/stockfish/stockfish-windows-x86-64-avx2.exe
# Linux: /usr/games/stockfish or /usr/local/bin/stockfish
STOCKFISH_PATH=stockfish
STOCKFISH_THREADS=2
STOCKFISH_HASH_MB=128
STOCKFISH_MULTI_PV=3
STOCKFISH_DEFAULT_DEPTH=15
STOCKFISH_TIMEOUT_MS=300

# LLM Provider Configuration ('gemini' or 'openai')
LLM_PROVIDER=gemini

# Gemini API Key (when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI API Key (when LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Redis Cache (Optional - falls back to in-memory TTL cache if empty or unreachable)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=86400
